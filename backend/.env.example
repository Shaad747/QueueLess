# Local Postgres.app connection. Use your actual macOS/PostgreSQL user.
PGHOST=localhost
PGPORT=5432
PGDATABASE=queueless
PGUSER=shaad
# Set PGPASSWORD only if your local database requires a password.
# PGPASSWORD=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_TIMEZONE=Asia/Kolkata
PORT=3000
# Cloud alternative: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use the database provider's required SSL/certificate configuration.
# Production settings (set in hosting environment; do not commit real secrets):
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY_HOPS=1
